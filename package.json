{
  "name": "syd-and-dan-christmas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:integration": "node --env-file=.env.local scripts/integration.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/*.ts\" \"*.config.ts\" package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"tests/*.ts\" \"*.config.ts\" package.json tsconfig.json .prettierrc.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "latest",
    "@vercel/blob": "^2.8.0",
    "cheerio": "latest",
    "ipaddr.js": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.35.5",
    "undici": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "3.6.2",
    "tsx": "latest",
    "typescript": "latest"
  }
}
